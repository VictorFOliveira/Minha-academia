API_URL=http://localhost:3333
AGENT_ID=
AGENT_KEY=
ACCESS_ADAPTER=GENERIC_HTTP
DATA_DIR=./data

SYNC_INTERVAL_MS=30000
FLUSH_INTERVAL_MS=5000
REQUEST_TIMEOUT_MS=5000

LISTEN_HOST=0.0.0.0
LISTEN_PORT=8787
DEFAULT_CREDENTIAL_TYPE=RFID
LOCAL_SHARED_SECRET=
DEVICE_ID=catraca-entrada-01
DEVICE_UNLOCK_URL=

TCP_HOST=0.0.0.0
TCP_PORT=8788

# Control iD - modo Online
# Configure o equipamento para apontar os eventos Online para:
# http://IP_DO_AGENTE:8790/controlid
CONTROL_ID_HOST=0.0.0.0
CONTROL_ID_PORT=8790
CONTROL_ID_BASE_PATH=/controlid
CONTROL_ID_DEVICE_ID=
CONTROL_ID_DIRECTION=ENTRY
# catra | door | sec_box
CONTROL_ID_ACTION=catra
# clockwise | anticlockwise | both
CONTROL_ID_CATRA_DIRECTION=clockwise
CONTROL_ID_DOOR=1
CONTROL_ID_SEC_BOX_ID=
