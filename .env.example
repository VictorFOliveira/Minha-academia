# Banco / cache
POSTGRES_PASSWORD=academia_dev
DATABASE_URL=postgresql://academia:academia_dev@db:5432/minha_academia
REDIS_URL=redis://redis:6379
DB_POOL_MAX=20

# API
NODE_ENV=development
APP_PUBLIC_URL=http://localhost:8080
PASSWORD_RESET_MINUTES=30
METRICS_TOKEN=troque-por-token-de-metricas-com-24-ou-mais-caracteres
PORT=3333
JWT_SECRET=troque-por-um-segredo-aleatorio-com-32-caracteres-ou-mais
CORS_ORIGINS=http://localhost:8080
RATE_LIMIT_API=600
RATE_LIMIT_LOGIN=30
RATE_LIMIT_SECURITY=10
SEED_DEMO=true

# Jobs operacionais
ENABLE_JOBS=true
JOB_INTERVAL_MS=3600000

# Segredos de integrações por tenant
# Use valor aleatório longo em produção; alterar esta chave sem processo de rotação impede descriptografar secrets já salvos.
INTEGRATION_ENCRYPTION_KEY=troque-por-uma-chave-aleatoria-longa-e-exclusiva

# Superadmin da plataforma
PLATFORM_JWT_SECRET=troque-por-outro-segredo-aleatorio-e-independente
PLATFORM_ADMIN_NAME=Superadmin
PLATFORM_ADMIN_EMAIL=
PLATFORM_ADMIN_PASSWORD=

# Cobrança do próprio SaaS via Asaas
PLATFORM_ASAAS_ENV=SANDBOX
PLATFORM_ASAAS_API_KEY=
PLATFORM_ASAAS_WEBHOOK_TOKEN=
PLATFORM_ALERT_EMAIL=
SAAS_BILLING_DAY=10

# Web
VITE_API_URL=/api
